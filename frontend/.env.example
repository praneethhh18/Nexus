# Frontend env vars — only VITE_-prefixed vars are exposed to the client
# bundle by Vite. Anything else is build-time only.
#
# Copy to .env (gitignored) and fill in values.

# ── Sentry — production error reporting ────────────────────────────────
# Get DSN from sentry.io → your React project → Settings → Client Keys.
# Frontend DSN ships in the JS bundle by design — that's how Sentry
# expects it. PII is not sent (replay masks all text + media).
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=production
# 0.1 = sample 10% of page loads for performance traces. 1.0 for debugging.
VITE_SENTRY_TRACES_RATE=0.1

# Auto-stamped on releases by CI; not required locally.
VITE_APP_VERSION=
