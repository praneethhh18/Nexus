# Production .env values for /opt/nexusagent/.env.
# Fill secrets before starting nexus-api.service.

APP_BASE_URL=https://nexus.nexusagent.in
NEXUS_PUBLIC_URL=https://nexus.nexusagent.in
VOX_PUBLIC_URL=https://vox.nexusagent.in
LAB_URL=http://127.0.0.1:8765

WA_BRIDGE_URL=http://127.0.0.1:3001
WHATSAPP_BRIDGE_URL=http://127.0.0.1:3001
WHATSAPP_WEBHOOK_SECRET=

DATABASE_URL=postgresql://nexus:CHANGE_ME@127.0.0.1:5432/nexusagent
POSTGRES_POOL_ENABLED=1
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=10

JWT_SECRET=
VOICE_CALLBACK_SECRET=
VOX_SHARED_SECRET=

ALLOW_CLOUD_LLM=true
REDACT_PII=true
AUDIT_CLOUD_CALLS=true
REQUIRE_EMAIL_VERIFICATION=1
ENABLE_DEFAULT_ADMIN=0

GOOGLE_OAUTH_REDIRECT_URI=https://nexus.nexusagent.in/api/calendar/oauth/callback

# Optional provider keys.
ANTHROPIC_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
NEXUS_LLM_PROVIDER=bedrock
BEDROCK_MODEL_ID=mistral.ministral-3-14b-instruct
BEDROCK_FAST_MODEL_ID=us.amazon.nova-lite-v1:0

# Optional email/payment/error reporting.
RESEND_API_KEY=
EMAIL_FROM=NexusAgent <hi@nexusagent.in>
SUPPORT_EMAIL=hi@nexusagent.in
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SENTRY_DSN=
