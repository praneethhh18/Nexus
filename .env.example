# ═══════════════════════════════════════════════════════════════
# NexusAgent v3.0 — Environment Configuration
# Copy this file to .env and edit. Sensible defaults work out of the box.
# Anything starred (*) is strongly recommended for production.
# ═══════════════════════════════════════════════════════════════

# ── AI Provider ──────────────────────────────────────────────────
# Priority: Anthropic direct > Amazon Bedrock > local Ollama.
# Set exactly ONE group of credentials. The server picks automatically.

# Option 1 — Anthropic direct (best quality, easy)
# Get a key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# Option 2 — Amazon Bedrock (AWS). Leave ANTHROPIC_API_KEY blank to use these.
# Create an IAM user with policy AmazonBedrockFullAccess, generate an access key.
# Nova Pro is the reasoning/agent workhorse; Nova Lite handles cheap tasks.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
BEDROCK_FAST_MODEL_ID=us.amazon.nova-lite-v1:0

# Ollama — required for embeddings (always local, keeps RAG private)
# Also used as LLM fallback if neither Anthropic nor Bedrock creds are set.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M
OLLAMA_FALLBACK_MODEL=qwen2.5:3b-instruct-q4_K_M
EMBED_MODEL=nomic-embed-text:latest

# ── Privacy (data-leakage controls for cloud LLM) ────────────────
# Master kill-switch. When false, cloud LLMs are never called even if
# ANTHROPIC_API_KEY / AWS creds are set — everything falls back to Ollama.
ALLOW_CLOUD_LLM=true
# Redact emails, phones, IDs (Aadhaar/PAN/SSN), card numbers, API keys,
# IPs, and user-dir paths before sending prompts to the cloud. Responses
# are un-redacted locally before being shown to the user.
REDACT_PII=true
# Append one JSON record per cloud call to outputs/cloud_audit.jsonl
# (prompt SHA + char count + redaction count — never the raw prompt).
AUDIT_CLOUD_CALLS=true

# ── Auth / Security ──────────────────────────────────────────────
# * JWT signing secret. If unset, a random one is auto-generated at
#   data/.jwt_secret. Set this explicitly in production to keep tokens
#   valid across restarts and across multiple app servers.
JWT_SECRET=

# ── Integrations ─────────────────────────────────────────────────
# Email (for sending invoices, password resets, etc.)
# Get app password: Google Account > Security > 2-Step Verification > App passwords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Discord (webhook for alerts)
DISCORD_WEBHOOK_URL=

# Slack (incoming webhook URL for workflow notifications)
# Create at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=

# Google Calendar OAuth (optional — enables calendar sync)
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must include: http://localhost:8000/api/calendar/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/calendar/oauth/callback

# Public app URL (used in password-reset emails and Google OAuth redirect)
APP_BASE_URL=http://localhost:5173

# ── Vox Voice Agent (nexuscaller-lab) ────────────────────────────────────
# * LAB_URL — internal server-to-server URL.
#   Docker: set automatically by docker-compose (http://vox-server:8765).
#   Local dev: http://localhost:8765
LAB_URL=http://localhost:8765

# * VOX_PUBLIC_URL — browser-reachable URL for the precall / cockpit pages.
#   Docker / production: https://vox.yourdomain.com
#   Local dev: http://localhost:8765 (same as LAB_URL)
VOX_PUBLIC_URL=http://localhost:8765

# * NEXUS_PUBLIC_URL — public URL of THIS API server (used in the callback
#   URL sent to the vox lab so it can POST results back when a call ends).
#   Docker / production: https://app.yourdomain.com
#   Local dev: http://localhost:8000
NEXUS_PUBLIC_URL=http://localhost:8000

# Shared secret between NexusAgent and nexuscaller-lab for the callback endpoint.
# Set the same value in both .env files. Leave blank to skip verification (dev only).
# Generate one: openssl rand -hex 32
VOICE_CALLBACK_SECRET=

# WhatsApp bridge shared secret. If blank, one is auto-generated at
# data/.whatsapp_secret on first boot. Paste it into whatsapp_bridge/.env
# as NEXUS_WEBHOOK_SECRET, or copy it from Settings → WhatsApp (admin).
WHATSAPP_WEBHOOK_SECRET=

# ── Database ────────────────────────────────────────────────────
DB_PATH=data/nexusagent.db

# ── App Behavior ─────────────────────────────────────────────────
LOG_LEVEL=INFO
ANOMALY_THRESHOLD=0.15
MONITOR_INTERVAL_MINUTES=60
MAX_SQL_RETRIES=3
MAX_REFLECTION_RETRIES=2
TOP_K_RETRIEVAL=5
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ── SQL Safety ───────────────────────────────────────────────────
# Kill any single query that runs longer than this (seconds).
SQL_QUERY_TIMEOUT_SECONDS=30
# Hard cap on rows returned per query (0 = unlimited, not recommended).
SQL_MAX_ROWS=10000

# ── Email — Resend (production) ──────────────────────────────────
# Get key from resend.com/api-keys. EMAIL_FROM must use a verified domain.
# When unset, the app silently falls back to Gmail SMTP if those creds are set.
RESEND_API_KEY=
EMAIL_FROM=NexusAgent <hi@nexusagent.in>

# ── Vox provider keys (deployed in nexuscaller-lab) ──────────────
# These live in the lab's own .env, not NexusAgent's — but they're listed
# here so a fresh deployer knows the full surface. (LAB_URL / VOX_PUBLIC_URL
# / NEXUS_PUBLIC_URL / VOICE_CALLBACK_SECRET are already up in section above.)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_OUTBOUND_TRUNK_ID=
VOX_AGENT_NAME=Vox
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Twilio — webhook signature validation depends on TWILIO_AUTH_TOKEN.
# Set VOICE_INBOUND_VALIDATE=1 in production to enforce.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
VOICE_INBOUND_VALIDATE=0

# Shared secret between NexusAgent and the Vox lab. Random, ≥32 chars.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required by Vox /api/dial in production. Must match value in lab's .env.
VOX_SHARED_SECRET=

# Per-business daily outbound call cap (Vox lab only — set in lab .env).
# Prevents a runaway auto-dialer from burning the Twilio budget. Returns
# 429 from /api/dial after this many calls/business/day.
VOX_DAILY_CALL_CAP=200

# ── Cloud LLM cost guards ────────────────────────────────────────
# Per-business daily token cap. Default 1M is generous; tighten per tier:
#   Starter ₹999  → 100000
#   Pro ₹2499     → 500000
#   Privacy ₹5999 → 2000000
CLOUD_TOKEN_DAILY_CAP=1000000

# ── Backup ───────────────────────────────────────────────────────
# Used by scripts/backup_db.sh. AWS_REGION etc. should be set via the
# instance role on EC2; only override here if running off-AWS.
BACKUP_S3_BUCKET=
BACKUP_RETAIN_DAYS=14

# ── Sentry (production error reporting) ──────────────────────────
# Get DSN from sentry.io → Settings → Projects → Client Keys.
# When unset, Sentry is silently disabled (dev environments stay quiet).
# Education tier: 50K errors / 5GB logs / 5M spans per month for 1 year.
SENTRY_DSN=
SENTRY_ENV=production
# 0.1 = sample 10% of requests for perf monitoring; bump to 1.0 for debug
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Razorpay (payment gateway) ───────────────────────────────────
# Test keys: rzp_test_xxx (free, no KYC) — get from
#   dashboard.razorpay.com → Account & Settings → API Keys
# Live keys: rzp_live_xxx (after KYC verification + ₹199 fee).
# KEY_SECRET MUST stay server-side only. Frontend uses VITE_RAZORPAY_KEY_ID
# (public key, safe to ship in JS bundle).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxx
RAZORPAY_KEY_SECRET=

# ── Privacy Bridge ───────────────────────────────────────────────
# No env required for the SaaS side — bridges register themselves with
# tokens issued from Settings → Privacy Mode. The customer's installer
# manages its own settings.json.

# ── Migrations ───────────────────────────────────────────────────
# Set to 1 ONLY for emergency boots when a migration is broken and you
# need the server up to debug. Leave unset in normal operation.
NEXUS_SKIP_MIGRATIONS=0
